# Copy this file to .env (never committed — see .gitignore) and fill in
# a real key before running `npm start`. Deploying to Vercel instead? Set
# ANTHROPIC_API_KEY (and ANTHROPIC_MODEL, optionally) as Environment
# Variables in the project's Vercel settings — api/ai-brief.js reads the
# same two names; PORT is local-only, Vercel ignores it.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3001
